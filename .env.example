# Copy this file to .env and fill in your own keys.
# All VITE_-prefixed values are bundled into the client build — fine for
# free-tier weather/image keys, but see README's "API keys & security" note
# regarding the Gemini key.

VITE_OPENWEATHER_API_KEY=
VITE_UNSPLASH_ACCESS_KEY=
VITE_PEXELS_API_KEY=
VITE_GEMINI_API_KEY=

# Only needed if deploying the included /api/gemini.js serverless proxy
# (e.g. on Vercel). Set this in the Vercel dashboard, NOT in .env — it must
# never be VITE_-prefixed or it will end up in the client bundle.
# GEMINI_API_KEY=
